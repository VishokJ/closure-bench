#!/usr/bin/env python3
"""Propose plan items with a model; mechanical gates decide (docs/PROPOSER.md).

Runs on the host (model calls need the network and PRIME_API_KEY); every
simulation runs in the toolchain image with networking off.

  tools/propose_plan [--stage-a-only] [--full-docs] [--write] [--max-candidates N]
  tools/propose_plan --replay runs/propose/<run_id>      # no model calls
  tools/propose_plan --summarize runs/propose/<run_id>   # recompute summary.json
  tools/propose_plan --write-from runs/propose/<run_id>  # write its accepted items into designs/
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from closure_core import propose  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="propose plan items")
    ap.add_argument("--design", default="uart")
    ap.add_argument("--model", default="anthropic/claude-opus-5.5")
    ap.add_argument("--temperature", type=float, default=1.0)
    ap.add_argument("--max-tokens", type=int, default=16000)
    ap.add_argument("--max-candidates", type=int, default=20)
    ap.add_argument("--stage-a-only", action="store_true", help="only list candidates")
    ap.add_argument("--full-docs", action="store_true", help="send every document page")
    ap.add_argument("--write", action="store_true", help="write accepted items into designs/ and run tools/check")
    ap.add_argument("--no-survivor-pass", action="store_true",
                    help="skip pass 2 (Stage A again with the remaining baseline survivors)")
    ap.add_argument("--tag", default="", help="suffix for the run directory name")
    ap.add_argument("--image", default=os.environ.get("CLOSURE_BENCH_IMAGE", propose.IMAGE),
                    help="toolchain image (on Apple silicon pass the arm64 manifest digest)")
    ap.add_argument("--local", action="store_true", help="use the local Verilator instead of the image")
    ap.add_argument("-j", type=int, default=8)
    ap.add_argument("-p", type=int, default=4, help="Stage B candidates at a time (model calls overlap)")
    ap.add_argument("--replay", type=Path)
    ap.add_argument("--summarize", type=Path)
    ap.add_argument("--write-from", type=Path, help="write a finished run's accepted items (replays it first)")
    args = ap.parse_args()
    executor = propose.Executor(None if args.local else args.image, j=args.j)

    if args.summarize:
        s = propose.summarize(args.summarize.resolve())
        propose.dump(args.summarize / "summary.json", s)
        print(json.dumps(s, indent=2))
        return 0
    if args.write_from:
        errs = propose.write_from(args.write_from.resolve(), executor)
        if errs:
            print("NOT WRITTEN:\n  " + "\n  ".join(errs))
            return 1
        s = propose.load(args.write_from / "summary.json")
        print(f"written: {s.get('written')}; tools/check exit {s.get('check_exit')}")
        return 0 if s.get("check_exit") == 0 else 1
    if args.replay:
        diffs = propose.replay(args.replay.resolve(), executor)
        print("\n".join(diffs) or "REPRODUCED: every recorded decision, repair message and the summary")
        return 1 if diffs else 0

    model = propose.PrimeModel(args.model, args.temperature, args.max_tokens)
    run_dir = propose.new_run_dir(args.tag)
    s = propose.run(run_dir, model, executor, design_name=args.design, max_candidates=args.max_candidates,
                    stage_a_only=args.stage_a_only, full_docs=args.full_docs, write=args.write,
                    survivor_pass=not args.no_survivor_pass, parallel=args.p)
    print(json.dumps(s, indent=2))
    print(f"\nrun: {run_dir.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
