#!/usr/bin/env python3
"""Summarise vf-eval runs: pass@1 per (model, harness, settings) and task.

A run dir holds configs/resolved/eval.json and traces.jsonl (one line per
rollout). Rollouts group by model, harness and sampling max_tokens, so a rerun
with a larger token budget is its own row rather than merged into the first.

Per rollout:
  infra_error   no graded trace (provider error, sandbox failure): excluded
                from every rate, counted separately
  truncated     no model call at all, or the last call ended with
                finish_reason == "length"
  outcome       no_submission (nothing to grade), policy_violation,
                compile_error, timeout, runtime_error, no_finish (grader
                status), missed (ran clean, a target has 0 hits), hit (reward 1)

pass@1 is the mean reward over graded rollouts. Per task the interval is
Wilson 95%. Per group it is a 95% percentile bootstrap that resamples tasks
(2,000 resamples, fixed seed): rollouts cluster by task, so a pooled Wilson
interval would be too narrow.

run_sh_calls counts assistant tool calls whose payload mentions run.sh (bash
harness: the agent simulating its own testbench); 0 under the null harness.

Writes <out>/summary.json, <out>/tables.md, <out>/pass_at_1.png and
<out>/outcomes.png. Same inputs give byte-identical outputs.

Usage:  uv run --extra analyze tools/analyze_eval RUN_DIR|PARENT_DIR ... [--out results/eval]
(the analyze extra brings matplotlib for the charts; --no-charts needs only the stdlib)
"""

from __future__ import annotations

import argparse
import json
import math
import random
import re
import statistics
import sys
from collections import Counter, defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

OUTCOMES = ["no_submission", "policy_violation", "compile_error", "timeout",
            "runtime_error", "no_finish", "missed", "hit"]
Z95 = 1.959963984540054
BOOTSTRAP_RESAMPLES = 2000
BOOTSTRAP_SEED = 0


def wilson(k: int, n: int, z: float = Z95) -> tuple[float, float] | None:
    if n == 0:
        return None
    p = k / n
    denom = 1 + z * z / n
    centre = (p + z * z / (2 * n)) / denom
    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    return (max(0.0, centre - half), min(1.0, centre + half))


def bootstrap_tasks(counts: list[tuple[int, int]], resamples: int = BOOTSTRAP_RESAMPLES,
                    seed: int = BOOTSTRAP_SEED) -> tuple[float, float] | None:
    """95% percentile interval of pooled pass@1 (sum hits / sum rollouts) when the
    tasks, given as (hits, rollouts), are resampled with replacement."""
    counts = [c for c in counts if c[1]]
    if not counts:
        return None
    rng = random.Random(seed)
    vals = []
    for _ in range(resamples):
        draw = [counts[rng.randrange(len(counts))] for _ in counts]
        vals.append(sum(k for k, _ in draw) / sum(n for _, n in draw))
    vals.sort()
    return (vals[int(0.025 * resamples)], vals[int(0.975 * resamples) - 1])


def run_sh_calls(trace: dict) -> int:
    n = 0
    for node in trace.get("nodes") or []:
        m = node.get("message") or {}
        if m.get("role") == "assistant":
            n += sum("run.sh" in json.dumps(tc) for tc in m.get("tool_calls") or [])
    return n


def classify(trace: dict | None) -> dict:
    """One rollout -> the fields the summary needs."""
    if trace is None or not (trace.get("info") or {}).get("grade"):
        return {"outcome": "infra_error", "stop": (trace or {}).get("stop_condition")}
    info, metrics, calls = trace["info"], trace.get("metrics") or {}, trace.get("calls") or []
    reward = float(((trace.get("rewards") or {}).get("target_reached") or {}).get("score", 0.0))
    status = info["grade"]["status"]
    if reward == 1.0:
        outcome = "hit"
    elif not (info.get("submission") or "").strip():
        outcome = "no_submission"
    elif status == "ok":
        outcome = "missed"
    else:
        outcome = status
    return {
        "outcome": outcome,
        "reward": reward,
        "truncated": not calls or calls[-1].get("finish_reason") == "length",
        "no_reply": not calls,
        "tokens": trace.get("num_total_tokens", 0),
        "input_tokens": trace.get("num_input_tokens", 0),
        "cached_input_tokens": metrics.get("cached_input_tokens", 0.0),
        "output_tokens": trace.get("num_output_tokens", 0),
        "run_sh_calls": run_sh_calls(trace),
        "turns": metrics.get("turns", len(calls)),
        "sim_seconds": metrics.get("sim_seconds", 0.0),
        "source": info.get("submission_source") or "none",
        "stop": trace.get("stop_condition"),
    }


def run_dirs(paths: list[Path]) -> list[Path]:
    out = set()
    for p in paths:
        if (p / "traces.jsonl").exists():
            out.add(p.resolve())
        else:
            out.update(c.resolve().parent for c in p.glob("*/traces.jsonl"))
    if not out:
        sys.exit(f"no traces.jsonl under {', '.join(map(str, paths))}")
    return sorted(out)


def group_of(run_dir: Path) -> dict:
    cfg = json.loads((run_dir / "configs" / "resolved" / "eval.json").read_text())
    env = cfg["env"]
    harness = ((env.get("agent") or {}).get("harness") or {}).get("id") or env["taskset"]["harness"]
    return {"model": cfg["model"], "harness": harness,
            "max_tokens": (cfg.get("sampling") or {}).get("max_tokens"),
            "max_turns": (env.get("agent") or {}).get("max_turns")}


def label(g: dict) -> str:
    s = f"{g['model']} · {g['harness']} · max_tokens={g['max_tokens']}"
    return s + (f" · max_turns={g['max_turns']}" if g["max_turns"] else "")


def load(paths: list[Path]) -> tuple[dict, dict]:
    """-> ({label: group}, {label: {task: [rollout]}})."""
    groups, rollouts = {}, defaultdict(lambda: defaultdict(list))
    for d in run_dirs(paths):
        g = group_of(d)
        lab = label(g)
        groups.setdefault(lab, {**g, "runs": []})["runs"].append(d.name)
        with open(d / "traces.jsonl") as f:
            for line in f:
                rec = json.loads(line)
                traces = rec.get("traces") or [None]
                rollouts[lab][rec["task"]["data"]["id"]].append(classify(traces[0]))
    return groups, rollouts


def task_key(t: str):
    return [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", t)]


def rnd(x):
    if isinstance(x, float):
        return round(x, 4)
    if isinstance(x, (list, tuple)):
        return [rnd(v) for v in x]
    if isinstance(x, dict):
        return {k: rnd(v) for k, v in x.items()}
    return x


def stats(rs: list[dict]) -> dict:
    graded = [r for r in rs if r["outcome"] != "infra_error"]
    kept = [r for r in graded if not r["truncated"]]
    n, k = len(graded), sum(r["reward"] == 1.0 for r in graded)
    nk, kk = len(kept), sum(r["reward"] == 1.0 for r in kept)
    oc = Counter(r["outcome"] for r in graded)
    mean = lambda f: sum(r[f] for r in graded) / n if n else None  # noqa: E731
    # no-reply rollouts (agent timeout before the first response) report 0 output
    # tokens though the model was generating: left out of the token statistics
    trunc = [r["output_tokens"] for r in graded if r["truncated"] and not r["no_reply"]]
    fin = [r["output_tokens"] for r in kept]
    return {
        "rollouts": len(rs),
        "infra_errors": len(rs) - n,
        "graded": n,
        "hits": k,
        "pass_at_1": k / n if n else None,
        "wilson95": wilson(k, n),
        "truncated": n - nk,
        "truncation_rate": (n - nk) / n if n else None,
        "no_reply": sum(r["no_reply"] for r in graded),
        "pass_at_1_untruncated": kk / nk if nk else None,
        "wilson95_untruncated": wilson(kk, nk),
        "outcomes": {o: oc.get(o, 0) for o in OUTCOMES + sorted(set(oc) - set(OUTCOMES))},
        "mean_tokens": mean("tokens"),
        "mean_input_tokens": mean("input_tokens"),
        "mean_cached_input_tokens": mean("cached_input_tokens"),
        "mean_output_tokens": mean("output_tokens"),
        "output_tokens_finished": {"mean": statistics.mean(fin) if fin else None,
                                   "median": statistics.median(fin) if fin else None},
        "output_tokens_truncated": {"mean": statistics.mean(trunc) if trunc else None,
                                    "median": statistics.median(trunc) if trunc else None},
        "all_truncated": bool(n) and nk == 0,
        "mean_turns": mean("turns"),
        "mean_run_sh_calls": mean("run_sh_calls"),
        "rollouts_calling_run_sh": sum(r["run_sh_calls"] > 0 for r in graded),
        "mean_sim_seconds": mean("sim_seconds"),
        "submission_source": dict(sorted(Counter(r["source"] for r in graded).items())),
        "stop_condition": dict(sorted(Counter(str(r["stop"]) for r in rs).items())),
    }


def summarise(groups: dict, rollouts: dict) -> dict:
    out = {"groups": []}
    for lab in sorted(groups):
        tasks = {t: stats(rollouts[lab][t]) for t in sorted(rollouts[lab], key=task_key)}
        agg = stats([r for t in tasks for r in rollouts[lab][t]])
        del agg["wilson95"], agg["wilson95_untruncated"]   # per-task intervals only
        agg["bootstrap95"] = bootstrap_tasks([(s["hits"], s["graded"]) for s in tasks.values()])
        agg["bootstrap95_untruncated"] = bootstrap_tasks(
            [(s["hits"], s["graded"] - s["truncated"]) for s in tasks.values()])
        agg["all_truncated_tasks"] = [t for t, s in tasks.items() if s["all_truncated"]]
        rates = [s["pass_at_1"] for s in tasks.values() if s["pass_at_1"] is not None]
        agg["task_mean_pass_at_1"] = sum(rates) / len(rates) if rates else None
        g = groups[lab]
        out["groups"].append(rnd({"label": lab, "model": g["model"], "harness": g["harness"],
                                  "max_tokens": g["max_tokens"], "max_turns": g["max_turns"],
                                  "runs": sorted(g["runs"]), "aggregate": agg, "tasks": tasks}))
    return out


# --- markdown ---------------------------------------------------------------

def pct(x) -> str:
    return "–" if x is None else f"{100 * x:.0f}%"


def ci(p, iv) -> str:
    return "–" if p is None else f"{pct(p)} [{pct(iv[0])}, {pct(iv[1])}]"


def num(x, fmt="{:.0f}") -> str:
    return "–" if x is None else fmt.format(x)


def tok(d: dict) -> str:
    return "–" if d["mean"] is None else f"{d['mean']:.0f} / {d['median']:.0f}"


def table(head: list[str], rows: list[list[str]]) -> str:
    lines = ["| " + " | ".join(head) + " |", "|" + "|".join("---" for _ in head) + "|"]
    return "\n".join(lines + ["| " + " | ".join(r) + " |" for r in rows])


def markdown(summary: dict) -> str:
    gs = summary["groups"]
    short = {g["label"]: f"G{i + 1}" for i, g in enumerate(gs)}
    parts = ["# Eval summary", "",
             "pass@1 = mean reward over graded rollouts. Intervals are 95%: per group, a "
             f"percentile bootstrap resampling tasks ({BOOTSTRAP_RESAMPLES} resamples, seed "
             f"{BOOTSTRAP_SEED}); per task, Wilson. Truncated = no reply, or the last call "
             "ended with finish_reason == length. Infra errors (never graded) are excluded "
             "from every rate. A task bootstrap has zero width when every task has the same "
             "rate (e.g. all 4/4): it ignores sampling noise within a task. Output-token "
             "statistics leave out no-reply rollouts (timed out before the first response; "
             "their token count is not recorded).", "",
             table(["", "group", "runs"],
                   [[short[g["label"]], g["label"], ", ".join(g["runs"])] for g in gs]), "",
             "## Per group", ""]
    rows = []
    for g in gs:
        a = g["aggregate"]
        rows.append([short[g["label"]], f"{a['graded']} (+{a['infra_errors']} infra)",
                     ci(a["pass_at_1"], a["bootstrap95"]), pct(a["task_mean_pass_at_1"]),
                     ci(a["pass_at_1_untruncated"], a["bootstrap95_untruncated"]),
                     pct(a["truncation_rate"]), num(a["mean_input_tokens"]),
                     num(a["mean_output_tokens"]), num(a["mean_turns"], "{:.1f}"),
                     f"{num(a['mean_run_sh_calls'], '{:.1f}')} ({a['rollouts_calling_run_sh']})",
                     num(a["mean_sim_seconds"], "{:.1f}"),
                     ", ".join(f"{k} {v}" for k, v in a["submission_source"].items())])
    parts += [table(["", "rollouts", "pass@1 [bootstrap 95%]", "task mean",
                     "pass@1 untruncated [bootstrap 95%]", "truncated", "in tokens", "out tokens",
                     "turns", "run.sh calls (rollouts)", "sim s", "submission"], rows), ""]
    flagged = [(short[g["label"]], g["aggregate"]["all_truncated_tasks"]) for g in gs]
    if any(ts for _, ts in flagged):
        parts += ["Every rollout truncated: " + "; ".join(
            f"{s}: {', '.join(ts)}" for s, ts in flagged if ts) + ".", ""]
    parts += ["## Outcomes per group (graded rollouts)", ""]
    extra = sorted({o for g in gs for o in g["aggregate"]["outcomes"]} - set(OUTCOMES))
    parts += [table([""] + OUTCOMES + extra,
                    [[short[g["label"]]] + [str(g["aggregate"]["outcomes"].get(o, 0))
                                            for o in OUTCOMES + extra] for g in gs]), ""]
    tasks = sorted({t for g in gs for t in g["tasks"]}, key=task_key)
    parts += ["## pass@1 per task (Wilson 95%)", ""]
    parts += [table(["task"] + [short[g["label"]] for g in gs],
                    [[t] + [ci(g["tasks"][t]["pass_at_1"], g["tasks"][t]["wilson95"])
                            + f" (n={g['tasks'][t]['graded']})" if t in g["tasks"] else "–"
                            for g in gs] for t in tasks]), ""]
    parts += ["## Per task detail", ""]
    for g in gs:
        rows = []
        for t, s in g["tasks"].items():
            oc = ", ".join(f"{o} {c}" for o, c in s["outcomes"].items() if c)
            rows.append([t, f"{s['graded']}" + (f" (+{s['infra_errors']})" if s["infra_errors"] else ""),
                         ci(s["pass_at_1"], s["wilson95"]),
                         ci(s["pass_at_1_untruncated"], s["wilson95_untruncated"]),
                         pct(s["truncation_rate"]) + (" **all**" if s["all_truncated"] else "")
                         + (f" ({s['no_reply']} no reply)" if s["no_reply"] else ""),
                         tok(s["output_tokens_finished"]), tok(s["output_tokens_truncated"]),
                         oc, num(s["mean_turns"], "{:.1f}"), num(s["mean_sim_seconds"], "{:.1f}")])
        parts += [f"### {short[g['label']]}: {g['label']}", "",
                  table(["task", "n", "pass@1 [Wilson 95%]", "untruncated", "truncated",
                         "out tokens finished (mean / median)",
                         "out tokens truncated (mean / median)", "outcomes", "turns", "sim s"],
                        rows), ""]
    return "\n".join(parts)


# --- charts -----------------------------------------------------------------

SURFACE, INK, MUTED, GRID = "#fcfcfb", "#0b0b0b", "#52514e", "#e4e3df"
SERIES = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"]


def charts(summary: dict, out: Path) -> None:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.patches import Patch

    plt.rcParams.update({"font.size": 9, "text.color": INK, "axes.labelcolor": MUTED,
                         "xtick.color": MUTED, "ytick.color": MUTED, "axes.edgecolor": GRID,
                         "svg.hashsalt": "closure-bench"})
    gs = summary["groups"]
    meta = {"Software": None}

    # pass@1 per task, one series per group, Wilson interval as error bar
    tasks = sorted({t for g in gs for t in g["tasks"]}, key=task_key)
    fig, ax = plt.subplots(figsize=(max(6, 0.6 * len(tasks) + 2), 3.6), facecolor=SURFACE)
    ax.set_facecolor(SURFACE)
    width = 0.7 / max(1, len(gs))
    for i, g in enumerate(gs):
        xs, ys, lo, hi = [], [], [], []
        for j, t in enumerate(tasks):
            s = g["tasks"].get(t)
            if not s or s["pass_at_1"] is None:
                continue
            xs.append(j + (i - (len(gs) - 1) / 2) * width)
            ys.append(s["pass_at_1"])
            lo.append(s["pass_at_1"] - s["wilson95"][0])
            hi.append(s["wilson95"][1] - s["pass_at_1"])
        ax.errorbar(xs, ys, yerr=[lo, hi], fmt="o", ms=6, color=SERIES[i % 8], ecolor=SERIES[i % 8],
                    elinewidth=1.5, capsize=0, mec=SURFACE, mew=1.5, label=g["label"])
    ax.set_xticks(range(len(tasks)), tasks)
    ax.set_ylim(-0.03, 1.03)
    ax.set_ylabel("pass@1 (Wilson 95%)")
    ax.yaxis.grid(True, color=GRID, lw=0.8)
    ax.set_axisbelow(True)
    for side in ("top", "right"):
        ax.spines[side].set_visible(False)
    ax.legend(loc="upper center", bbox_to_anchor=(0.5, -0.12), ncol=1, frameon=False, fontsize=8)
    fig.tight_layout()
    fig.savefig(out / "pass_at_1.png", dpi=150, metadata=meta, facecolor=SURFACE)
    plt.close(fig)

    # outcome shares per group, stacked horizontal bars
    fig, ax = plt.subplots(figsize=(8, 0.55 * len(gs) + 1.8), facecolor=SURFACE)
    ax.set_facecolor(SURFACE)
    order = list(reversed(OUTCOMES))   # hit first, at the left
    for i, g in enumerate(gs):
        a = g["aggregate"]
        left = 0.0
        for c, o in enumerate(order):
            share = a["outcomes"].get(o, 0) / a["graded"] if a["graded"] else 0
            if share:
                ax.barh(i, share, left=left, height=0.6, color=SERIES[c], edgecolor=SURFACE, lw=2)
                if share >= 0.08:
                    ax.text(left + share / 2, i, f"{100 * share:.0f}%", ha="center", va="center",
                            fontsize=7.5, color="#ffffff")
            left += share
    ax.set_yticks(range(len(gs)), [f"{g['label']}\n(n={g['aggregate']['graded']})" for g in gs],
                  fontsize=7.5)
    ax.invert_yaxis()
    ax.set_xlim(0, 1)
    ax.xaxis.set_major_formatter(matplotlib.ticker.PercentFormatter(1.0))
    for side in ("top", "right", "left"):
        ax.spines[side].set_visible(False)
    ax.tick_params(axis="y", length=0)
    ax.legend([Patch(color=SERIES[c]) for c in range(len(order))], order, loc="upper center", bbox_to_anchor=(0.5, -0.15),
              ncol=4, frameon=False, fontsize=8)
    fig.tight_layout()
    fig.savefig(out / "outcomes.png", dpi=150, metadata=meta, facecolor=SURFACE)
    plt.close(fig)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("dirs", nargs="+", type=Path, help="run dirs, or dirs holding run dirs")
    ap.add_argument("--out", type=Path, default=ROOT / "results" / "eval")
    ap.add_argument("--no-charts", action="store_true")
    args = ap.parse_args()

    summary = summarise(*load(args.dirs))
    args.out.mkdir(parents=True, exist_ok=True)
    (args.out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
    md = markdown(summary)
    (args.out / "tables.md").write_text(md + "\n")
    if not args.no_charts:
        charts(summary, args.out)
    print(md)
    return 0


if __name__ == "__main__":
    sys.exit(main())
