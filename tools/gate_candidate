#!/usr/bin/env python3
"""Gate one candidate plan item (closure_core/candidate.py) without touching designs/.

Runs in the pipeline image (closure_core.propose.IMAGE).

Usage:  tools/gate_candidate <candidate_dir> [--design uart | --base PACK] [-j N] [--out result.json] [--offline]
                             [--witness-cache DIR] [--min-frames F] [--require-mechanism]
                             [--mutation-cache FILE] [--witness-store DIR | --no-witness-store]
Prints one line per gate and writes the full result as JSON.
Exit 0 if the candidate is accepted, 1 if rejected, 2 on an infrastructure error
(formal tools, or a simulation timing out twice): no result written, not a decision.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from closure_core import candidate, gates, infra  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="gate one candidate plan item")
    ap.add_argument("candidate", type=Path)
    ap.add_argument("--design", default="uart")
    ap.add_argument("--base", type=Path, help="gate against this pack instead of designs/<design>")
    ap.add_argument("-j", type=int, default=infra.default_jobs(), help="parallel simulations (default: cores - 2)")
    ap.add_argument("--out", type=Path, help="result JSON (default: <candidate>/gates.json)")
    ap.add_argument("--offline", action="store_true", help="do not download cited documents")
    ap.add_argument("--mutation-cache", "--cache", dest="cache", type=Path, default=gates.MUTATION_CACHE,
                    help=f"mutant simulation results, shared and merged (default {gates.MUTATION_CACHE})")
    ap.add_argument("--witness-cache", type=Path, default=ROOT / "results" / "check" / "witnesses",
                    help="formal witnesses by key (a proposer run passes its own)")
    store = ap.add_mutually_exclusive_group()
    store.add_argument("--witness-store", type=Path, default=gates.witness_store(),
                       help="shared witness store, looked up after --witness-cache (default: "
                            f"{gates.WITNESSES}/<formal.py hash>)")
    store.add_argument("--no-witness-store", action="store_true", help="solve without the shared store")
    ap.add_argument("--min-frames", type=float, help="reject target witnesses shorter than this many frames")
    ap.add_argument("--require-mechanism", action="store_true",
                    help="item.yaml must declare at least two difficulty mechanisms (target-only proposer runs)")
    args = ap.parse_args()

    base = args.base.resolve() if args.base else ROOT / "designs" / args.design
    try:
        res = candidate.gate(base, args.candidate.resolve(),
                             cache_path=args.cache.resolve(), j=args.j, offline=args.offline,
                             witness_cache=args.witness_cache.resolve(), min_frames=args.min_frames,
                             require_mechanism=args.require_mechanism,
                             witness_store=None if args.no_witness_store or not args.witness_store
                             else args.witness_store.resolve())
    except infra.InfraError as e:
        print(f"INFRASTRUCTURE ERROR (no decision recorded): {e}", file=sys.stderr)
        return 2
    out = (args.out or args.candidate / "gates.json").resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(res, indent=2, default=str) + "\n")

    sym = {True: "pass", False: "FAIL", None: "unverified", "n/a": "n/a"}
    width = max(map(len, candidate.ORDER))
    print(f"{res['item'] or args.candidate.name}")
    for g in res["gates"]:
        lines = (g["detail"] or "").splitlines() or [""]
        print(f"  {g['gate']:<{width}}  {sym[g['ok']]:<10}  {lines[0]}")
        for extra in lines[1:]:
            print(f"  {'':<{width}}  {'':<10}  {extra}")
    for g in res["skipped"]:
        print(f"  {g:<{width}}  skipped")
    print(f"\n{'ACCEPTED' if res['accepted'] else 'REJECTED at ' + res['failed_gate']}  (result: {out})")
    return 0 if res["accepted"] else 1


if __name__ == "__main__":
    sys.exit(main())
