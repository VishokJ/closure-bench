#!/usr/bin/env python3
"""Build the proposer's context pack (closure_core/propose.py). Runs in the toolchain
image: it simulates the baselines for their coverage holes and extracts doc pages.

Usage:  tools/context_pack --out pack.json [--design uart | --design PACK_DIR] [--full-docs] [-j N]
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from closure_core import load_design, propose  # noqa: E402
from closure_core.infra import default_jobs  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="build the proposer context pack")
    ap.add_argument("--out", type=Path, required=True)
    ap.add_argument("--design", default="uart")
    ap.add_argument("--full-docs", action="store_true", help="every page, not only context_pages")
    ap.add_argument("-j", type=int, default=default_jobs(),
                    help="parallel simulations (mutants, golds; default: cores - 2)")
    args = ap.parse_args()
    propose.dump(args.out, propose.build_context_pack(load_design(args.design), full_docs=args.full_docs,
                                                      j=args.j))
    return 0


if __name__ == "__main__":
    sys.exit(main())
