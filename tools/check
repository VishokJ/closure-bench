#!/usr/bin/env python3
"""Validity suite: every plan item must pass every gate before it can be a task.

Runs every gate in closure_core/gates.py (see its docstring for what each
checks) on every selected item, in parallel, and prints a full report.
Duplicates are compared among the selected items only.

Mutant results are cached in results/check/mutation_cache.json.

Usage:  tools/check [--design uart] [--item R1 ...] [--offline] [-j N]
Exit 0 only if every gate passes for every selected item.
"""

from __future__ import annotations

import argparse
import json
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from closure_core import citations, gates, load_design  # noqa: E402
from closure_core.grader import score, simulate  # noqa: E402

ORDER = ["citations", "cover_sync", "cover_policy", "baseline", "gold", "near_miss", "determinism", "value", "duplicate"]


def main() -> int:
    ap = argparse.ArgumentParser(description="closure-bench validity suite")
    ap.add_argument("--design", default="uart")
    ap.add_argument("--item", action="append", help="limit to these plan IDs")
    ap.add_argument("--offline", action="store_true", help="do not download cited documents")
    ap.add_argument("-j", type=int, default=4, help="parallel simulations")
    ap.add_argument("--report", type=Path, default=ROOT / "results" / "check" / "report.json")
    args = ap.parse_args()
    report = args.report.resolve()

    design = load_design(args.design)
    items = [it for it in design.plan if not args.item or it.id in args.item]
    res: dict[str, dict[str, gates.GateResult]] = {it.id: {} for it in items}

    def put(item, r: gates.GateResult):
        res[item][r.gate] = r

    # cover_sync (also catches covers with no plan item)
    labels = gates.cover_labels(design)
    orphans = sorted(set(labels) - {it.cover for it in design.plan})
    for it in items:
        put(it.id, gates.cover_sync(it, labels))
        put(it.id, gates.cover_policy(design, it))

    golds = {it.id: design.golds[it.id] for it in items if it.id in design.golds}
    with ThreadPoolExecutor(args.j) as pool:
        # One simulation per baseline gives hits for every item at once.
        base_futs = {name: pool.submit(simulate, design, b["file"].read_text(), top=b["top"])
                     for name, b in design.baselines.items()}
        rand_futs = {name: pool.submit(simulate, design, b["file"].read_text(), top=b["top"])
                     for name, b in design.randoms.items()}
        gold_futs = {i: tuple(pool.submit(simulate, design, p.read_text()) for _ in range(2))
                     for i, p in golds.items()}
        near_futs = {it.id: [(p.name, pool.submit(simulate, design, p.read_text()))
                             for p in design.near_misses.get(it.id, ())] for it in items}
        gold_policy = {i: pool.submit(gates.testbench_policy, design, p, gold=True)
                       for i, p in golds.items()}
        near_policy = {it.id: {p.name: pool.submit(gates.testbench_policy, design, p, gold=False)
                               for p in design.near_misses.get(it.id, ())} for it in items}

        baselines = {name: f.result() for name, f in base_futs.items()}
        randoms = {name: f.result() for name, f in rand_futs.items()}
        base_points = [p for s in baselines.values() for p in s.points]
        corpus = {f"baseline:{n}": s.plan_hits for n, s in baselines.items() if s.sim.status == "ok"}
        corpus.update({f"random:{n}": s.plan_hits for n, s in randoms.items() if s.sim.status == "ok"})
        hole_list = gates.holes(baselines)
        closed: dict[str, list[str]] = {}

        for it in items:
            put(it.id, gates.baseline(it, baselines, randoms))
            sa, sb = (f.result() for f in gold_futs[it.id]) if it.id in gold_futs else (None, None)
            if sa and sa.sim.status == "ok":
                closed[it.id] = sorted(set(hole_list) & gates.hit_points(sa))
            a, b = (score(design, [it.id], s) if s else None for s in (sa, sb))
            if a and a.status == "ok":
                corpus[f"gold:{it.id}"] = a.plan_hits
            put(it.id, gates.gold(it, a, gold_policy[it.id].result() if it.id in gold_policy else ()))
            put(it.id, gates.determinism(a, b))
            nm = [(n, f.result()) for n, f in near_futs[it.id]]
            corpus.update({f"near_miss:{n}": s.plan_hits for n, s in nm if s.sim.status == "ok"})
            put(it.id, gates.near_miss(
                it, [(n, score(design, [it.id], s)) for n, s in nm],
                {n: f.result() for n, f in near_policy[it.id].items()},
                {n: gates.line_overlap(sa, s) for n, s in nm} if sa else None))

        mutation = gates.mutation_runs(design, golds, pool, report.with_name("mutation_cache.json"))

    dups, duplicate = gates.duplicate(corpus, [it.id for it in items], mutation["gold_kills"])
    for i, r in dups.items():
        put(i, r)

    store = citations.DocStore(design.pack, offline=args.offline)
    for it in items:
        c = gates.citations(design, it, store, base_points)
        put(it.id, c)
        put(it.id, gates.value(mutation["gold_kills"].get(it.id, []),
                               mutation["only_gold_kills"].get(it.id, []), c.data["verified"]))
    value = {i: r["value"].data for i, r in res.items()}
    by_path = {p: sorted(i for i, v in value.items() if v["evidence"] == p)
               for p in ("mutant", "spec", "both", "none")}
    opted_out = sorted(i for i, r in res.items() if r["near_miss"].data.get("opted_out"))
    by_random = {i: r["baseline"].data["hit_by_random"] for i, r in res.items() if r["baseline"].data["hit_by_random"]}
    rand_bad = [f"{n}: status {s.sim.status}" for n, s in randoms.items() if s.sim.status != "ok"]
    waived = gates.waived_holes(design)
    bad_hole_waivers = sorted(k for k in waived if k not in hole_list)
    closed_any = set().union(*closed.values()) if closed else set()
    open_holes = [k for k in hole_list if k not in waived]
    holes = {"total": len(hole_list), "waived": len([k for k in hole_list if k in waived]),
             "closed_by_golds": sorted(closed_any - set(waived)),
             "remaining": sorted(set(open_holes) - closed_any),
             "per_item": closed, "bad_waivers": bad_hole_waivers}

    # report
    sym = {True: "pass", False: "FAIL", None: "unverified", "n/a": "n/a"}
    width = max(len(g) for g in ORDER)
    all_ok = not orphans
    for it in items:
        print(f"\n{it.id}  ({it.cover}, {it.provenance.get('status', '?')})")
        for g in ORDER:
            r = res[it.id][g]
            all_ok &= r.ok in (True, "n/a")
            print(f"  {g:<{width}}  {sym[r.ok]:<10}  {r.detail.splitlines()[0] if r.detail else ''}")
            for extra in r.detail.splitlines()[1:]:
                print(f"  {'':<{width}}  {'':<10}  {extra}")
    if orphans:
        print(f"\nFAIL  covers with no plan item: {orphans}")
    m = mutation
    print(f"\nmutants: {m['mutants']} generated, {len(m['stillborn'])} stillborn, {m['valid']} valid; "
          f"baseline kills {m['baseline_killed']} ({m['baseline_score']}), "
          f"baseline + golds {m['baseline_plus_gold_score']}; "
          f"{len(m['waived'])} waived, {len(m['unexplained'])} unexplained survivors")
    print("value evidence: " + ", ".join(f"{p} {len(v)}" for p, v in by_path.items()))
    audit = sorted(set(by_path["spec"]) | set(opted_out))
    print(f"always audited: {', '.join(audit) or '-'} (spec-only value: {', '.join(by_path['spec']) or '-'}; "
          f"near-miss opt-outs: {', '.join(opted_out) or '-'})")
    print(f"hit by random stimulus: {', '.join(f'{i} {h}' for i, h in by_random.items()) or '-'}")
    print(f"holes: {holes['total']} in the baseline, {holes['waived']} waived, "
          f"{len(holes['closed_by_golds'])} closed by golds, {len(holes['remaining'])} remaining")
    if rand_bad:
        all_ok = False
        print(f"FAIL  random testbenches did not run cleanly: {rand_bad}")
    if bad_hole_waivers:
        all_ok = False
        print(f"FAIL  hole waivers on points that are not baseline holes: {bad_hole_waivers}")
    for i, js in duplicate["implies"].items():
        print(f"implies: gold {i} also hits {', '.join(js)}")
    if m["bad_waivers"]:
        all_ok = False
        print(f"FAIL  waivers on mutants that are killed or do not exist: {m['bad_waivers']}")

    report.parent.mkdir(parents=True, exist_ok=True)
    report.write_text(json.dumps(
        {"design": design.name, "orphan_covers": orphans, "mutation": mutation,
         "duplicate": duplicate,
         "value": {"items": value, "by_evidence": by_path, "spec_only_audit": by_path["spec"]},
         "audit": {"always": audit, "spec_only": by_path["spec"], "near_miss_opt_outs": opted_out},
         "hit_by_random": by_random, "holes": holes,
         "items": {i: {g: {"ok": r.ok, "detail": r.detail} for g, r in gs.items()}
                   for i, gs in res.items()}},
        indent=2, default=str) + "\n")
    shown = report.relative_to(ROOT) if report.is_relative_to(ROOT) else report
    print(f"\n{'ALL GATES PASS' if all_ok else 'SOME GATES FAIL OR UNVERIFIED'}  (report: {shown})")
    return 0 if all_ok else 1


if __name__ == "__main__":
    sys.exit(main())
